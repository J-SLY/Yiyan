<script>
  import storage from '@blueos.storage.storage'
  export default {
    data: {},
    onCreate() {
      const history = storage.getSync({ key: 'history' })
      const stars = storage.getSync({ key: 'stars' })
      if (history == '') this.set('history', [])
      if (stars == '') this.set('stars', [])
    },
    set(key, value) {
      storage.set({
        key: key,
        value: JSON.stringify(value),
      })
    },
    get(key) {
      const data = this.getValue(key, [])
      return Array.isArray(data) ? data : []
    },
    getValue(key, fallback) {
      const value = storage.getSync({ key: key })
      if (value == '') return fallback
      try {
        return JSON.parse(value)
      } catch (e) {
        return fallback
      }
    },
    push(key, value) {
      let data = this.get(key)
      data.push(value)
      if (key == 'history') {
        if (data.length > 20) data = data.slice(-20)
      }
      this.set(key, data)
    },
    include(key, value) {
      const data = this.get(key)
      return data.includes(value)
    },
    dele(key, index) {
      let data = this.get(key)
      if (index >= 0 && index < data.length) data.splice(index, 1)
      this.set(key, data)
    },
  }
</script>
