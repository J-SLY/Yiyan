<script>
  import fetch from '@blueos.network.fetch'
  import prompt from '@blueos.window.prompt'
  export default {
    data: {
      type: '',
      text: '',
      uuid: '',
      source: '',
      author: '',
      tags: '',
      star: false,
      canStar: true,
      isLoading: false,
      isError: false,
    },
    onInit() {
      if (this.$app.$def.include('stars', this.text)) {
        this.star = true
      }
      if (this.type === 'get') {
        this.getYiyan()
      } else {
        this.loadMetadata()
      }
    },
    loadMetadata() {
      const metadata = this.$app.$def.getValue('sayingMeta', [])
      const item = metadata.find((value) => value.content === this.text)
      if (item) this.applyMetadata(item)
    },
    applyMetadata(item) {
      this.uuid = item.uuid || ''
      this.source = item.source || ''
      this.author = item.author || ''
      this.tags = Array.isArray(item.matchedTags)
        ? item.matchedTags.join('、')
        : ''
    },
    saveMetadata(item, text) {
      const record = this.$app.$def
      const metadata = record.getValue('sayingMeta', [])
      const next = {
        uuid: typeof item.uuid === 'string' ? item.uuid : '',
        content: text,
        source: typeof item.source === 'string' ? item.source : '',
        author: typeof item.author === 'string' ? item.author : '',
        matchedTags: Array.isArray(item.matchedTags) ? item.matchedTags : [],
      }
      const index = metadata.findIndex((value) => value.content === text)
      if (index >= 0) metadata[index] = next
      else metadata.push(next)
      record.set('sayingMeta', metadata)
      this.applyMetadata(next)
    },
    getYiyan() {
      this.text = 'Loading...'
      this.uuid = ''
      this.source = ''
      this.author = ''
      this.tags = ''
      this.star = false
      this.canStar = false
      this.isLoading = true
      this.isError = false
      const api = this.$app.$def.getValue('sayingApi', 'random')
      fetch.fetch({
        url:
          api === 'legacy'
            ? 'https://uapis.cn/api/v1/saying'
            : 'https://uapis.cn/api/v1/saying/random?mode=random',
        responseType: 'json',
        success: (res) => {
          const payload = (res && res.data) || res
          const item = payload && payload.item
          const text =
            api === 'legacy'
              ? payload && payload.text
              : item
                ? item.content
                : payload && payload.content
          if (typeof text !== 'string' || !text) {
            this.useOffline()
            return
          }
          this.isLoading = false
          this.isError = false
          this.canStar = true
          const record = this.$app.$def
          this.text = text
          this.saveMetadata(item || payload, text)
          record.push('history', text)
          if (record.include('stars', text)) {
            this.star = true
          }
        },
        fail: () => this.useOffline(),
      })
    },
    useOffline() {
      const text = this.$app.$def.getValue('offlineText', this.$app.$def.getValue('offlineTexts', []))
      if (Array.isArray(text) && text.length > 0) {
        const available = text.filter((value) => typeof value === 'string' && value)
        if (available.length > 0) {
          this.text = available[Math.floor(Math.random() * available.length)]
          this.uuid = ''
          this.source = ''
          this.author = ''
          this.tags = ''
          this.isLoading = false
          this.isError = false
          this.canStar = true
          this.saveOfflineHistory()
          return
        }
      }
      this.text = '获取失败，请重试'
      this.isLoading = false
      this.isError = true
      this.canStar = false
    },
    saveOfflineHistory() {
      const record = this.$app.$def
      record.push('history', this.text)
      this.star = record.include('stars', this.text)
    },
    giveStar() {
      if (!this.canStar) return
      const record = this.$app.$def
      if (record.include('stars', this.text)) {
        const stars = record.get('stars')
        record.dele('stars', stars.indexOf(this.text))
        this.star = false
        prompt.showToast({
          message: '取消收藏成功',
        })
      } else {
        record.push('stars', this.text)
        this.star = true
        prompt.showToast({
          message: '已收藏成功',
        })
      }
    },
  }
</script>

<template>
  <div class="wrapper">
    <text class="text">{{ text }}</text>
    <text class="meta" show="{{isError}}">
      Tips: 可以前往设置下载离线数据哦
    </text>
    <text class="meta" show="{{source!=''}}">出处：{{ source }}</text>
    <text class="meta" show="{{author!=''}}">作者：{{ author }}</text>
    <text class="meta" show="{{tags!=''}}">标签：{{ tags }}</text>
    <input
      type="button"
      class="btn"
      value="换一条"
      show="{{type=='get'}}"
      disabled="{{isLoading}}"
      @click="getYiyan" />
    <input
      type="button"
      class="btn"
      value="{{star?'取消收藏':'收藏'}}"
      disabled="{{!canStar}}"
      @click="giveStar" />
  </div>
</template>

<style lang="scss">
  @import './../../assets/styles/global.scss';
  .meta {
    width: 88%;
    color: $grey;
    font-size: 3.5 * $size-factor;
    margin-top: 1 * $size-factor;
    text-align: center;
  }
</style>
